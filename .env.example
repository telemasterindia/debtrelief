# Public canonical origin of the site (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# CONSULTATION LEAD EMAIL (required in production) — server-side only, never NEXT_PUBLIC_.
# Every valid /free-consultation submission is emailed to Telemasterindia@gmail.com via Resend (https://resend.com).
# API key from Resend > API Keys (sending access is enough).
RESEND_API_KEY=
# Sender shown on the lead emails. Must be an address on a domain verified in Resend,
# e.g. "Greenlight Leads <leads@greenlightdebtrelief.com>". Before a domain is verified, Resend only
# allows "onboarding@resend.dev" and only to the Resend account owner's own email address.
LEAD_EMAIL_FROM=

# OPTIONAL: also POST each consultation lead (and contact-form messages) as JSON to a CRM/Zapier/Make webhook.
# Contact-form messages are delivered ONLY via this webhook.
LEAD_WEBHOOK_URL=
# Optional shared secret sent as the "X-Webhook-Secret" header so the receiver can verify the sender.
LEAD_WEBHOOK_SECRET=

# Set to "true" ONLY for local testing of a production build without email/webhook configured.
# Submissions are then accepted and discarded (nothing is stored or sent).
ALLOW_LEAD_DISCARD=

# Maximum form submissions per IP address per 10 minutes (default 5).
FORM_RATE_LIMIT=

# SEARCH VISIBILITY — keep unset/false during this phase. Set to "true" only when you decide to "Enable SEO".
# WARNING: never deploy with indexing disabled on the live greenlightdebtrelief.com domain —
# it would remove the existing site from Google/Bing results.
NEXT_PUBLIC_ENABLE_INDEXING=

# Optional password protection for staging/preview, format "username:password".
SITE_BASIC_AUTH=
